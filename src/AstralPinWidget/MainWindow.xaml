<Window x:Class="AstralPinWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AstralPinWidget.ViewModels"
        mc:Ignorable="d"
        Title="Astral Pin Widget"
        Width="218"
        Height="192"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Topmost="{Binding IsTopmost}"
        Loaded="Window_OnLoaded"
        LocationChanged="Window_OnLocationChanged"
        Closing="Window_OnClosing"
        SourceInitialized="Window_OnSourceInitialized">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#EEF6F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style x:Key="TopmostToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Frame"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="#101513"
                                BorderBrush="#2F3A35"
                                BorderThickness="1"
                                CornerRadius="1">
                            <Viewbox Width="10"
                                     Height="10"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="12" Height="12">
                                    <Path x:Name="Icon"
                                          Data="M 2,6 L 5,9 L 10,3"
                                          Stroke="#6F7F77"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#56645D"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="#9CADA4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#0E1A15"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#2B7855"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="#35D889"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#18221E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Frame"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="#101513"
                                BorderBrush="#2F3A35"
                                BorderThickness="1"
                                CornerRadius="1">
                            <Viewbox Width="9"
                                     Height="9"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="12" Height="12">
                                    <Path x:Name="Icon"
                                          Data="M 3,3 L 9,9 M 9,3 L 3,9"
                                          Stroke="#75827B"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#7D4B4F"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="#D9898F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#211315"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Grid Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Height="20">
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding StatusBrush}"
                             Stroke="#9CFFD8"
                             StrokeThickness="0.7"
                             VerticalAlignment="Center"
                             ToolTip="{Binding StatusTooltip}"/>
                    <TextBlock Text="{Binding Label}"
                               Margin="5,0,0,0"
                               FontSize="12.5"
                               FontWeight="Regular"
                               Foreground="#B7C5BF"
                               LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="1,0,2,0" VerticalAlignment="Center">
                    <Border Height="4" CornerRadius="2" Background="#26322F"/>
                    <Border Height="4"
                            Width="{Binding BarWidth}"
                            CornerRadius="2"
                            Background="{Binding StatusBrush}"
                            HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayCurrent}"
                           FontSize="12.3"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{Binding ValueBrush}"
                           ToolTip="{Binding VoltageTooltip}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WidgetRoot"
            Margin="0"
            Padding="9,6,7,5"
            CornerRadius="4"
            Background="#EB07090A"
            BorderBrush="#26302C"
            BorderThickness="0"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="WidgetRoot_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8"
                              ShadowDepth="0"
                              Color="#AA000000"
                              Opacity="0.45"/>
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Always on top"
                          IsCheckable="True"
                          IsChecked="{Binding IsTopmost, Mode=TwoWay}"/>
                <MenuItem Header="Refresh"
                          Command="{Binding RefreshCommand}"/>
                <Separator/>
                <MenuItem Header="Exit"
                          Click="ExitMenuItem_OnClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ASUS 5090 ASTRAL (BTF)"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#F4FFF9"/>
                    <TextBlock Text="12V-2x6 monitoring"
                               FontSize="9.2"
                               FontWeight="Regular"
                               Foreground="#8D9B95"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <ToggleButton Style="{StaticResource TopmostToggleStyle}"
                                  IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                  ToolTip="Always on top"/>
                    <Button Style="{StaticResource HeaderCloseButtonStyle}"
                            Click="ExitMenuItem_OnClick"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Pins}"/>

            <Grid Grid.Row="2" Margin="0,3,0,0" Height="19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding TotalLine}"
                           FontSize="12.2"
                           FontWeight="Regular"
                           Foreground="#F1FAF5"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding LastUpdatedLine}"
                           FontSize="10.2"
                           Foreground="#7D8A84"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
